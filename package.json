{
  "name": "jobetl",
  "version": "1.0.0",
  "description": "Scheduled job lead crawler that matches offers against a CV and stores results in a local SQLite database.",
  "license": "ISC",
  "author": "dandrok",
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --clean",
    "dev": "tsx src/cli.ts scrape",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "report": "tsx src/cli.ts report",
    "import:notion": "tsx src/cli.ts import-notion",
    "sync:notion": "tsx src/cli.ts sync-notion",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "api": "tsx src/cli.ts serve",
    "dashboard": "concurrently \"npm run api\" \"npm run dev:ui\"",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' 'ui/**/*.{ts,svelte}'",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'ui/**/*.{ts,svelte}' --plugin prettier-plugin-svelte",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'ui/**/*.{ts,svelte}' --plugin prettier-plugin-svelte",
    "check": "npm run format:check && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.29",
    "ai": "^6.0.158",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.6.0",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.4"
  }
}
