# --- Database ---
DATABASE_URL=postgres://jobetl_user:secure_password_here@127.0.0.1:5432/jobetl

# --- Dashboard authentication ---
# Generate with: npm run hash:password
# Single quotes matter - the Argon2 digest contains '$'.
DASHBOARD_PASSWORD_HASH=

# --- Server ---
# HOST defaults to 127.0.0.1 in production (nginx proxies to it) and 0.0.0.0 otherwise.
PORT=3001
HOST=127.0.0.1
# Only set true when a reverse proxy you control sets X-Real-IP. On a directly
# exposed server this lets anyone forge their IP and bypass login rate limiting.
TRUST_PROXY=false
# Dev only; production is same-origin behind nginx and sends no CORS headers.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# --- Scraping & matching ---
JINA_API_KEY=
DEEPSEEK_API_KEY=

# --- Notion sync ---
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Email alerts ---
RESEND_API_KEY=
SENDER_EMAIL=
RECIPIENT_EMAIL=
